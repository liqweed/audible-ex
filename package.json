{
  "name": "audible-ex",
  "description": "Shows Goodreads ratings, genres and years on Audible book cards, with personal filters.",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "test": "bun test",
    "typecheck": "wxt prepare && tsc --noEmit",
    "lint": "biome lint",
    "format": "biome check --write",
    "check": "biome ci && bun run typecheck && bun test",
    "e2e": "wxt build && playwright test --pass-with-no-tests",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tooltip": "1.2.8",
    "@tanstack/pacer": "0.23.1",
    "@tanstack/react-store": "0.11.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "effect": "4.1.0",
    "lucide-react": "0.544.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@happy-dom/global-registrator": "21.0.4",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.0",
    "@types/bun": "1.4.0",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@wxt-dev/module-react": "1.1.5",
    "playwright": "1.55.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wxt": "0.21.5"
  }
}
